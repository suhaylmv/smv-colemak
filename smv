// smv, Spanish

partial alphanumeric_keys
xkb_symbols "colemak" {

    name[Group1]= "smv";

    key <TLDE> { [   dead_grave, dead_circumflex,   dead_grave,         NoSymbol ] };
    key <AE01> { [            1,           at,               1,         NoSymbol ] };
    key <AE02> { [            2,      percent,               2,         NoSymbol ] };
    key <AE03> { [            3,   numbersign,               3,         NoSymbol ] };
    key <AE04> { [            4,       dollar,               4,         NoSymbol ] };
    key <AE05> { [            5,     EuroSign,               5,         NoSymbol ] };
    key <AE06> { [            6,       degree,               6,         NoSymbol ] };
    key <AE07> { [            7, dead_diaeresis,             7,         NoSymbol ] };
    key <AE08> { [            8,     multiply,               8,         NoSymbol ] };
    key <AE09> { [            9,  bracketleft,               9,         NoSymbol ] };
    key <AE10> { [            0, bracketright,               0,         NoSymbol ] };
    key <AE11> { [    backslash, questiondown,       backslash,         NoSymbol ] };
    key <AE12> { [   asciitilde,   exclamdown,      asciitilde,         NoSymbol ] };

    key <AD01> { [            q,            Q,               q,         NoSymbol ] };
    key <AD02> { [            w,            W,           minus,         NoSymbol ] };
    key <AD03> { [            f,            F,        asterisk,         NoSymbol ] };
    key <AD04> { [            p,            P,       ampersand,         NoSymbol ] };
    key <AD05> { [            g,            G,             bar,         NoSymbol ] };
    key <AD06> { [            j,            J,               j,         NoSymbol ] };
    key <AD07> { type[Group1] = "SMV_NAV", [ l, L, Prior, Prior ] };
    key <AD08> { type[Group1] = "SMV_NAV", [ u, U, Next, Next ] };
    key <AD09> { type[Group1] = "SMV_NAV", [ y, Y, Delete, Delete ] };
    key <AD10> { [   underscore,    semicolon,      underscore,         NoSymbol ] };
    key <AD11> { [        grave,    braceleft,       semicolon,         NoSymbol ] };
    key <AD12> { [   braceright,   braceright,      braceright,         NoSymbol ] };
    key <BKSL> { [       emdash,     ellipsis,          endash,         NoSymbol ] };

    key <AC01> { [            a,            A,            less,         NoSymbol ] };
    key <AC02> { [            r,            R,           colon,         NoSymbol ] };
    key <AC03> { [            s,            S,           equal,           ssharp ] };
    key <AC04> { [            t,            T,          exclam,         NoSymbol ] };
    key <AC05> { [            d,            D,         greater,         NoSymbol ] };
    key <AC06> { [            h,            H,               h,         NoSymbol ] };
    key <AC07> { type[Group1] = "SMV_NAV", [ n, N, Left, Left ] };
    key <AC08> { type[Group1] = "SMV_NAV", [ e, E, Right, Right ] };
    key <AC09> { type[Group1] = "SMV_NAV", [ i, I, Up, Up ] };
    key <AC10> { type[Group1] = "SMV_NAV", [ o, O, Down, Down ] };
    key <AC11> { [   apostrophe,     quotedbl,      apostrophe,         NoSymbol ] };

    key <AB01> { [            z,            Z,               z,         NoSymbol ] };
    key <AB02> { [            x,            X,               x,         NoSymbol ] };
    key <AB03> { [            c,            C,            plus,         NoSymbol ] };
    key <AB04> { [            v,            V,     asciicircum,         NoSymbol ] };
    key <AB05> { [            b,            B,               b,         NoSymbol ] };
    key <AB06> { type[Group1] = "SMV_NAV", [ k, K, Home, Home ] };
    key <AB07> { type[Group1] = "SMV_NAV", [ m, M, End, End ] };
    key <AB08> { [        comma,    parenleft,           comma,         NoSymbol ] };
    key <AB09> { [       period,   parenright,          period,         NoSymbol ] };
    key <AB10> { [        slash,     question,           slash,         NoSymbol ] };

    key <CAPS> { [       Escape,       Escape,          Escape,           Escape ] };
    key <LSGT> { [   dead_acute,       ntilde,          Ntilde,           Ntilde ] };
    key <SPCE> { [        space,        space,           space,            space ] };

    include "level3(ralt_switch)"
};
